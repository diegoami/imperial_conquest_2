config_version=5

[application]

boot_splash/show_image=false

config/name="Open Imperial Conquest"
config/icon="res://Assets/Icon/icon.png"
config/windows_native_icon="res://Assets/Icon/icon.ico"
run/main_scene="res://UI/AppRoot.tscn"
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.7", "C#")

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=5

[display]

window/size/viewport_width=1500
window/size/viewport_height=850
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="IC2.MapViewer"

[gui]

theme/custom="res://UI/AppTheme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
