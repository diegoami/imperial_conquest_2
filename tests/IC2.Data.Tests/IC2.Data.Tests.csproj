<Project Sdk="Microsoft.NET.Sdk">

  <!--
    T01 pre-declares this test project (docs/build-orchestration-plan.md "T01 Build scaffolding
    and CI"). TargetFramework/Nullable/ImplicitUsings/TreatWarningsAsErrors come from the
    repo-root Directory.Build.props (conditioned on this project's name) - note this applies only
    to this test project's own code, not to the existing IC2.Data project it references, which
    keeps its own settings unchanged. Only a placeholder test lived here before T30; later tasks
    that need IC2.Data coverage add their own test files here without editing this project's
    .csproj.

    T30 is the one exception: its Done-when line 8 requires every local-only test to report an
    explicit "Skipped" test-runner result (not a silent pass) when assets.local.ini is absent.
    xunit 2.9.2's plain [Fact] only supports a compile-time Skip string, not a runtime decision, so
    T30 adds Xunit.SkippableFact ([SkippableFact] + Skip.If/Skip.IfNot) - a small, test-only,
    widely-used xunit v2 extension - rather than inventing an ad hoc "print and return early"
    convention that would just show as an ordinary pass.

    T34 adds a ProjectReference to IC2.Inspect: the path-independent corpus fixture's row shape
    (CorpusOutcome) and its generator/JSON (de)serialization (CorpusOutcomeGenerator) now live there
    as the single source of truth for what the corpus outcomes CLI flag emits and what the
    committed fixture is deserialized as - so CorpusSweepTests exercises the exact same code the CLI
    runs, rather than a parallel copy that could drift from it.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/IC2.Data/IC2.Data.csproj" />
    <ProjectReference Include="../../src/IC2.Inspect/IC2.Inspect.csproj" />
  </ItemGroup>

</Project>
