<Project Sdk="Microsoft.NET.Sdk">

  <!--
    T01 pre-declares this test project (docs/build-orchestration-plan.md "T01 Build scaffolding
    and CI"). TargetFramework/Nullable/ImplicitUsings/TreatWarningsAsErrors come from the
    repo-root Directory.Build.props (conditioned on this project's name). Only a placeholder test
    lives here; each later task under src/IC2.Engine owns its own subfolder of
    tests/IC2.Engine.Tests, per that task's Owns list.

    T29 adds Xunit.SkippableFact: its Done-when line 6 requires every local-only test to report an
    explicit "Skipped" test-runner result (not a silent pass) when assets.local.ini is absent. xunit
    2.9.2's plain [Fact] only supports a compile-time Skip string, not a runtime decision, so this
    is the same package T30 added to tests/IC2.Data.Tests/IC2.Data.Tests.csproj for the identical
    reason (see that file's own comment) — not a second, independent choice.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/IC2.Engine/IC2.Engine.csproj" />

    <!--
      T21 (tests/IC2.Engine.Tests/Import/**): the import tests parse real .sav fixtures directly through
      IC2.Data, and resolve them by name (never a hardcoded folder) through IC2.Inspect's own
      CorpusFileLocator, the same one-shared-search-order resolver tests/IC2.Data.Tests already uses,
      rather than a second copy. Granted 2026-09-24, narrowly, by the user (docs/tasks/T21.md's Owns
      list): these two ProjectReferences only; the same unavoidable build-wiring change as the
      IC2.Engine.csproj reference above it; see this PR's body.
    -->
    <ProjectReference Include="../../src/IC2.Data/IC2.Data.csproj" />
    <ProjectReference Include="../../src/IC2.Inspect/IC2.Inspect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      T48 (tests/IC2.Engine.Tests/Assets/AssetPackFallbackResolutionTests.cs): DoD 4 needs "a test
      that points the loader at a pack with a deliberately missing entry", but
      godot/IC2.MapViewer.csproj is outside IC2.sln, so without this line the test could only
      exercise a hand-copied mirror of godot/Assets/AssetKeyResolver.cs, one that stays green even
      if the shipped fallback were deleted. Granted 2026-09-27, narrowly, by the user on PR #450's
      review (blocking finding 2), recorded in plan PR #451 and docs/tasks/T48.md's Owns list: this
      one Compile Include only, linking the real, Godot-free resolver class in place (never a
      second copy of it, and no other change to this file). AssetKeyResolver.cs itself has only a
      using IC2.Engine.Assets directive, no reference to Godot anywhere, so linking it here adds no
      Godot dependency to this project, the same guarantee T21's ProjectReference grant above gave
      for IC2.Data/IC2.Inspect.
    -->
    <Compile Include="../../godot/Assets/AssetKeyResolver.cs" Link="Assets/AssetKeyResolver.cs" />

    <!--
      T24 (tests/IC2.Engine.Tests/Ui/**): the same seam the AssetKeyResolver link above already
      established. RulesetPresets.cs and NewGameSelection.cs (which also carries GameSessionFactory
      and SeatOption) have no `using Godot` anywhere — both are exercised here by plain xunit tests
      rather than only by the headless Godot checks under godot/Checks/**, which CI cannot run (no
      Godot SDK). Never a second, hand-maintained copy of either file.
    -->
    <Compile Include="../../godot/UI/RulesetPresets.cs" Link="Ui/RulesetPresets.cs" />
    <Compile Include="../../godot/UI/NewGameSelection.cs" Link="Ui/NewGameSelection.cs" />

    <!--
      T25 (tests/IC2.Engine.Tests/Ui/Screens/**): the same seam, one file further. BattleResultViewModel.cs,
      DiplomacyGridViewModel.cs and HotseatHandoffDetector.cs (godot/Screens/**) each have no `using Godot`
      anywhere — every one is exercised here by plain xunit tests, never only by the headless Godot checks
      under godot/Screens/Checks/**, which CI cannot run (no Godot SDK). Never a second, hand-maintained
      copy of any of the three.
    -->
    <Compile Include="../../godot/Screens/BattleResultViewModel.cs" Link="Ui/Screens/BattleResultViewModel.cs" />
    <Compile Include="../../godot/Screens/DiplomacyGridViewModel.cs" Link="Ui/Screens/DiplomacyGridViewModel.cs" />
    <Compile Include="../../godot/Screens/HotseatHandoffDetector.cs" Link="Ui/Screens/HotseatHandoffDetector.cs" />
  </ItemGroup>

</Project>
